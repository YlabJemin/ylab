// 빈티지 필름 시계 (Infobar 248×58) — 필름 카운터(A)를 더 빈티지하게. 글씨체만 다른 4가지
//   주황 갈색 네거티브 필름 + 지글거리는 입자 + 가끔 스크래치·먼지 + 가장자리 빛샘 + 살짝 깜빡임
//   가장자리 글씨: DIN Condensed (옛 코닥 필름 가장자리 인쇄 느낌)
'use strict';
const VW = 248, VH = 58;
const VDAYS = ['SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'];
const v2 = (n) => String(n).padStart(2, '0');
const EDGE = "font-family='DIN Condensed, Futura, Helvetica Neue, sans-serif' font-weight='700'";
const FONTS = {
  typewriter: { label: 'A. 타자기 (American Typewriter)', fam: "'American Typewriter', 'Courier New', serif", w: 700, size: 25, fill: '#f3e3c3' },
  rockwell:   { label: 'B. 록웰 (Rockwell)',               fam: "Rockwell, 'American Typewriter', serif",   w: 700, size: 26, fill: '#f3e3c3' },
  copperplate:{ label: 'C. 코퍼플레이트 (Copperplate)',      fam: "Copperplate, Didot, serif",                w: 700, size: 25, fill: '#f3e3c3' },
  stamp:      { label: 'D. 옛날 사진 날짜 스탬프',             fam: "'DIN Condensed', 'Futura', sans-serif",     w: 700, size: 30, fill: '#ff8a3c', glow: true },
};
// 결정적 난수 (같은 프레임이면 같은 값)
const rnd = (n) => { const x = Math.sin(n * 12.9898) * 43758.5453; return x - Math.floor(x); };

function vintage(fontKey, d, ms) {
  const F = FONTS[fontKey];
  const speed = 16, off = (ms / 1000 * speed);
  const fr = Math.floor(ms / 90);                                         // 입자·흠집은 약 11장/초로 바뀜
  let holes = '', frames = '';
  for (let x = -14 + 4 - off % 14; x < VW + 14; x += 14) holes += `<rect x='${x.toFixed(1)}' y='4.5' width='7' height='5' rx='1.4' fill='#120a05'/><rect x='${x.toFixed(1)}' y='48.5' width='7' height='5' rx='1.4' fill='#120a05'/>`;
  for (let x = -96 - off % 96; x < VW + 96; x += 96) frames += `<rect x='${(x + 2).toFixed(1)}' y='12' width='92' height='34' rx='2' fill='#2b1608' opacity='0.55'/>`;
  // 가장자리 인쇄: 흘러가는 숫자 (필름 번호)
  let edge = '';
  for (let k = -1; k < 4; k++) {
    const x = k * 96 - off % 96 + 30, num = ((Math.floor(off / 96) + k) % 36 + 36) % 36 + 1;   // 필름 칸 번호 1~36
    edge += `<text x='${x.toFixed(1)}' y='3.6' ${EDGE} font-size='4.2' fill='#f2b25a' opacity='0.9'>${num}  ▶  ${num}A</text>`;
  }
  // 스크래치(가끔), 먼지
  let scratches = '';
  for (let k = 0; k < 2; k++) if (rnd(fr * 7 + k) > 0.72) { const x = rnd(fr * 3 + k * 11) * VW; scratches += `<rect x='${x.toFixed(1)}' y='0' width='${(0.4 + rnd(fr + k) * 0.6).toFixed(2)}' height='${VH}' fill='#fff2d8' opacity='${(0.18 + rnd(fr * 5 + k) * 0.3).toFixed(2)}'/>`; }
  for (let k = 0; k < 5; k++) { const x = rnd(fr * 13 + k) * VW, y = rnd(fr * 17 + k * 3) * VH, r = 0.4 + rnd(fr + k * 7) * 0.9; scratches += `<circle cx='${x.toFixed(1)}' cy='${y.toFixed(1)}' r='${r.toFixed(2)}' fill='${k % 2 ? '#1a0e06' : '#fbe9c8'}' opacity='0.55'/>`; }
  const flick = 0.04 * (rnd(fr * 1.7) - 0.5);                             // 밝기 깜빡임
  const time = `${v2(d.getHours())}:${v2(d.getMinutes())}`;
  const glow = F.glow ? `<text x='124' y='40' font-family="${F.fam}" font-weight='${F.w}' font-size='${F.size}' fill='#ff6a1a' text-anchor='middle' letter-spacing='1.5' filter='url(#blur)' opacity='0.85'>${time}</text>` : '';
  return `<svg xmlns='http://www.w3.org/2000/svg' width='${VW}' height='${VH}' viewBox='0 0 ${VW} ${VH}'>
  <defs>
    <linearGradient id='base' x1='0' y1='0' x2='1' y2='0'><stop offset='0' stop-color='#6a3615'/><stop offset='0.45' stop-color='#7d4318'/><stop offset='1' stop-color='#5c2d11'/></linearGradient>
    <radialGradient id='leak' cx='0.98' cy='0.1' r='0.6'><stop offset='0' stop-color='#ffb066' stop-opacity='0.55'/><stop offset='1' stop-color='#ff7a2a' stop-opacity='0'/></radialGradient>
    <radialGradient id='vig' cx='0.5' cy='0.5' r='0.75'><stop offset='0.6' stop-color='#000' stop-opacity='0'/><stop offset='1' stop-color='#000' stop-opacity='0.55'/></radialGradient>
    <filter id='grain' x='0' y='0' width='100%' height='100%'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' seed='${fr % 97}'/><feColorMatrix values='0 0 0 0 0.95  0 0 0 0 0.85  0 0 0 0 0.7  0 0 0 0.55 0'/></filter>
    <filter id='blur'><feGaussianBlur stdDeviation='1.6'/></filter>
  </defs>
  <rect width='${VW}' height='${VH}' fill='#0b0b0c'/>
  <rect x='0' y='1.5' width='${VW}' height='55' fill='url(#base)'/>
  ${frames}${holes}${edge}
  <rect x='74' y='11' width='100' height='36' rx='2.5' fill='#160b04' stroke='#c9733a' stroke-width='1' stroke-opacity='0.8'/>
  ${glow}<text x='124' y='40' font-family="${F.fam}" font-weight='${F.w}' font-size='${F.size}' fill='${F.fill}' text-anchor='middle' letter-spacing='1.5'>${time}</text>
  <text x='8' y='27' ${EDGE} font-size='9' fill='#f2b25a' letter-spacing='0.6'>KODAK 400</text>
  <text x='8' y='38' ${EDGE} font-size='8' fill='#f2b25a' opacity='0.85'>SAFETY FILM</text>
  <text x='${VW - 8}' y='27' ${EDGE} font-size='9' fill='#f2b25a' text-anchor='end' letter-spacing='0.6'>${VDAYS[d.getDay()]} ${d.getMonth() + 1}.${v2(d.getDate())}</text>
  <text x='${VW - 8}' y='38' ${EDGE} font-size='8' fill='#f2b25a' opacity='0.85' text-anchor='end'>${v2(d.getSeconds())}S</text>
  ${scratches}
  <rect width='${VW}' height='${VH}' filter='url(#grain)' opacity='0.5'/>
  <rect width='${VW}' height='${VH}' fill='url(#leak)'/>
  <rect width='${VW}' height='${VH}' fill='url(#vig)'/>
  <rect width='${VW}' height='${VH}' fill='${flick > 0 ? '#fff4e0' : '#000'}' opacity='${Math.abs(flick).toFixed(3)}'/>
</svg>`;
}
if (typeof module !== 'undefined') module.exports = { vintage, FONTS, VW, VH };
